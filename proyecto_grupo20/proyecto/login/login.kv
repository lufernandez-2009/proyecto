#:import dp kivy.metrics.dp

<LoginScreen>:
    theme_bg_color: "Custom"
    md_bg_color: 0.988, 0.906, 0.953, 1

    # Flecha para volver a Inicio
    MDIconButton:
        icon: "arrow-left"
        pos_hint: {"x": .05, "top": .92}
        theme_icon_color: "Custom"
        icon_color: 0.851, 0.310, 0.569, 1
        on_release: root.volver()

    # Contenido central
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        size_hint_x: None
        width: "320dp"
        spacing: "14dp"
        pos_hint: {"center_x": .5, "center_y": .5}

        # Título
        MDLabel:
            text: "Proyecto Integrador"
            font_style: "Headline"
            role: "small"
            theme_font_size: "Custom"
            font_size: "30sp"
            bold: True
            halign: "center"
            adaptive_height: True
            padding: 0, 0, 0, "16dp"
            theme_text_color: "Custom"
            text_color: 0.851, 0.310, 0.569, 1

        # Campo de correo
        MDTextField:
            id: correo
            mode: "filled"
            size_hint_y: None
            height: "56dp"
            radius: [dp(8), dp(8), dp(8), dp(8)]
            theme_bg_color: "Custom"
            fill_color_normal: .98, .98, .98, 1
            fill_color_focus: 1, 1, 1, 1
            theme_line_color: "Custom"
            line_color_normal: 0, 0, 0, 0
            line_color_focus: 0.851, 0.310, 0.569, 1

            MDTextFieldHintText:
                text: "Correo"
                theme_text_color: "Custom"
                text_color_normal: .4, .4, .4, 1
                text_color_focus: 0.851, 0.310, 0.569, 1

        # Campo de contraseña
        MDTextField:
            id: contrasena
            mode: "filled"
            password: True
            size_hint_y: None
            height: "56dp"
            radius: [dp(8), dp(8), dp(8), dp(8)]
            theme_bg_color: "Custom"
            fill_color_normal: .98, .98, .98, 1
            fill_color_focus: 1, 1, 1, 1
            theme_line_color: "Custom"
            line_color_normal: 0, 0, 0, 0
            line_color_focus: 0.851, 0.310, 0.569, 1

            MDTextFieldHintText:
                text: "Contraseña"
                theme_text_color: "Custom"
                text_color_normal: .4, .4, .4, 1
                text_color_focus: 0.851, 0.310, 0.569, 1

        # Botón para iniciar sesión
        MDButton:
            style: "filled"
            theme_width: "Custom"
            theme_height: "Custom"
            size_hint: 1, None
            height: "48dp"
            radius: [dp(6), dp(6), dp(6), dp(6)]
            theme_bg_color: "Custom"
            md_bg_color: 0.851, 0.310, 0.569, 1
            on_release: root.login()

            MDButtonText:
                text: "Iniciar sesión"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
